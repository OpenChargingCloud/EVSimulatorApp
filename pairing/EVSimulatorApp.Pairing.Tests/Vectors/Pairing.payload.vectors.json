    {
      "name": "query-instead-of-fragment",
      "what": "THE ONE THAT MATTERS MOST. Parameters in the query are not read, because a query is sent to the server: a format that worked either way would hand every scan to whoever runs the host. Malformed, not merely warned about.",
      "input": "https://open.charging.cloud/evsim/pair?v=1\u0026host=192.168.4.1\u0026port=15118",
      "outcome": "malformed",
      "error": "the pairing code carries no fragment; data in the query string is not read, because a query is sent to the server",
      "payload": null,
      "warnings": []
    },
