<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <!--
    The event stream carries every message twice — as JSON-LD and as the raw EXI frame — so it needs
    the codecs and their generated JSON-LD passes. It does not need the state machines: what produces
    the events is the app's own session runner, and this project only says what an event IS.
  -->
  <!--
    The command side of the bridge (SessionConfig) restricts a session to a private-range target, and
    that rule already exists: it is the same one the confirmation sheet applies to a scanned code.
    Having a second copy here is how the two would drift apart.
  -->
  <ItemGroup>
    <ProjectReference Include="../../pairing/EVSimulatorApp.Pairing/EVSimulatorApp.Pairing.csproj" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../libs/Vanaheimr.V2G.Exi/libs/WWCP_ISO15118/new/Vanaheimr.V2G.Exi.Iso15118_2/Vanaheimr.V2G.Exi.Iso15118_2.csproj" />
    <ProjectReference Include="../../libs/Vanaheimr.V2G.Exi/libs/WWCP_ISO15118/new/Vanaheimr.V2G.Exi.Iso15118_20.CommonMessages/Vanaheimr.V2G.Exi.Iso15118_20.CommonMessages.csproj" />
    <ProjectReference Include="../../libs/Vanaheimr.V2G.Exi/libs/WWCP_ISO15118/new/Vanaheimr.V2G.Exi.Iso15118_20.AC/Vanaheimr.V2G.Exi.Iso15118_20.AC.csproj" />
    <ProjectReference Include="../../libs/Vanaheimr.V2G.Exi/libs/WWCP_ISO15118/new/Vanaheimr.V2G.Exi.Iso15118_20.DC/Vanaheimr.V2G.Exi.Iso15118_20.DC.csproj" />
    <ProjectReference Include="../../libs/Vanaheimr.V2G.Exi/libs/WWCP_ISO15118/new/Vanaheimr.V2G.Exi.Prototype/Vanaheimr.V2G.Exi.Prototype.csproj" />
  </ItemGroup>

</Project>
